# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
/.idea
warp
*~
dist

# zst files
*.zst

# Locally generated Excel files, likely from polarwarp analysis
*.xlsx

# written by libcufile when running an RDMA build
cufile.log

# qreleaser state file
.release-state.sh
warp-release/

# local secrets — never commit
.env

# Python tooling (uv/pyenv artifacts — local environment only, not part of the Go project)
.python-version
.venv/

# Generated distribution sample data (re-create with: go run ./docs/sample_distributions)
docs/dist_samples.tsv
docs/dist_samples.log
